table Medidas
	lineageTag: 2f34cabf-a1b3-443b-859e-7d2e6cf51bb9

	measure 'Precio Venta' =
			
			LASTNONBLANKVALUE(
			    Fecha[Fecha],
			    INT(AVERAGE(movimientos[PrecioUnitario]))
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 558a8521-0300-4b5a-a209-a1ce6158febb

	measure 'Precio Compra' =
			
			LASTNONBLANKVALUE(
			    Fecha[Fecha],
			    INT(AVERAGE(movimientos[CostoUnitario]))
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 5c990607-2f17-4e47-8278-7dac8bec7e69

	measure 'Cantidad Vendida' =
			
			CALCULATE(
			    [Cantidad],
			    movimientos[TipoMovimiento] = "Venta"
			)
		formatString: #,0
		lineageTag: 3c414fcc-dfd0-47f6-968a-a8d4350b9687

	measure 'Cantidad Comprada' =
			
			CALCULATE(
			    [Cantidad],
			    movimientos[TipoMovimiento] = "Compra"
			)
		formatString: 0
		lineageTag: ff9a763a-53cb-4e92-bb6a-fe5444c6f4ae

	measure 'Costo Venta' =
			
			VAR PRINCIP = [Precio Compra]
			
			VAR SECUND = CALCULATE(
			    [Precio Compra],
			    DATEADD(Fecha[Fecha], -1, MONTH)
			)
			
			VAR TERC = CALCULATE(
			    [Precio Compra],
			    DATEADD(Fecha[Fecha], -2, MONTH)
			)
			
			VAR RESULT =
			COALESCE(PRINCIP, SECUND, TERC)
			
			RETURN RESULT
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: e8771f12-ecb2-442d-9654-6d2efeabc465

	measure 'Precio Venta_pro' =
			
			VAR PRINCIP = [Precio Venta]
			
			VAR SECUND = CALCULATE(
			    [Precio Venta],
			    DATEADD(Fecha[Fecha], -1, MONTH)
			)
			
			VAR TERC = CALCULATE(
			    [Precio Venta],
			    DATEADD(Fecha[Fecha], -2, MONTH)
			)
			
			VAR RESULT =
			COALESCE(PRINCIP, SECUND, TERC)
			
			RETURN RESULT
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: f4623c4e-d5fa-443a-89cb-62dbfc7b3804

	measure Ventas =
			
			CALCULATE(
			    [Monto],
			    movimientos[TipoMovimiento] = "Venta"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 0c0175b1-b050-4a77-8291-aaa7abbb70d9

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Compras =
			
			CALCULATE(
			    [Monto],
			    movimientos[TipoMovimiento] = "Compra"
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 52d27587-83a3-4cef-845d-0fdfdaa98441

	measure 'Costo de Ventas' =
			
			CALCULATE(
			    SUMX(movimientos, movimientos[Cantidad] * movimientos[CostoUnitario]),
			    movimientos[TipoMovimiento] = "Venta"
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: a06fe8e4-32d8-47b9-a5d3-b4189b6fa4c6

	measure '% Margen de Ventas' = DIVIDE([Ventas] - [Costo de Ventas], [Ventas], BLANK())
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 353d3396-a69d-47ba-94d9-c2ecb7494ed5

	measure Cantidad = SUM(movimientos[Cantidad])
		formatString: #,0
		displayFolder: Medidas Auxiliares
		lineageTag: 5f4170a5-5a83-4b76-9e45-c8c399f5df21

	measure Monto = SUM(movimientos[Monto])
		formatString: #,0.00
		displayFolder: Medidas Auxiliares
		lineageTag: 9ac25f98-b007-486b-9bb7-28f91e351bad

	measure 'Movimientos de Inventario' = [Entradas Inventario] - [Salidas Inventario]
		formatString: 0
		displayFolder: Medidas Inventarios
		lineageTag: 2e46a8c0-9664-44a2-b8c6-c330701ca6e7

	measure 'AUX_Monto Inventario diario' =
			
			CALCULATE(
			    [Monto],
			    FILTER(
			        movimientos,
			        movimientos[TipoMovimiento] = "Control Stock diario"
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Medidas Inventarios
		lineageTag: 23f0630a-73cf-4903-b994-cf01d1efa1ae

	measure AUX_InventarioAnteriorFecha =
			
			VAR MAX_FECHA = MAX(Fecha[Fecha])
			
			VAR ABSMIN_FECHA =
			CALCULATE(
			    MIN(Fecha[Fecha]),
			    ALL(Fecha)
			)
			
			VAR MEDIDA =
			CALCULATE(
			    LASTNONBLANK(
			        Fecha[Fecha],
			        CALCULATE(
			            [AUX_Monto Inventario diario],
			            DATEADD(Fecha[Fecha], -1, DAY)
			        )
			    ),
			    FILTER(
			        ALL(Fecha),
			        Fecha[Fecha] <= MAX_FECHA
			    )
			)
			
			RETURN COALESCE(MEDIDA-1, ABSMIN_FECHA)
		formatString: Short Date
		displayFolder: Medidas Auxiliares
		lineageTag: 923ee20c-e6f3-46e5-8db1-c3f0cb99f1ec

	measure AUX_MaximaFechaActual = MAX(Fecha[Fecha])
		formatString: General Date
		displayFolder: Medidas Auxiliares
		lineageTag: aa7ff268-a6ad-4285-934f-536232b5cea0

	measure 'Movimientos acumulados' =
			
			VAR MAX_FECHA = [AUX_MaximaFechaActual]
			
			VAR ULTIMO_INVENTARIO_FECHA = [AUX_InventarioAnteriorFecha]
			
			VAR MEDIDA =
			CALCULATE(
			    [Movimientos de Inventario],
			    FILTER(
			        ALL(Fecha),
			        Fecha[Fecha] >= ULTIMO_INVENTARIO_FECHA + 1
			        && Fecha[Fecha] <= MAX_FECHA
			    )
			)
			
			RETURN MEDIDA
		formatString: #,0
		displayFolder: Medidas Inventarios
		lineageTag: 007bd2c1-b2cd-4ce3-8123-6c74457f389e

	measure AUX_UltimoInventario =
			
			VAR FECHA_ULTIMOINVENTARIO = [AUX_InventarioAnteriorFecha]
			
			VAR MEDIDA =
			CALCULATE(
			    [AUX_Monto Inventario diario],
			    FILTER(
			        ALL(Fecha),
			        Fecha[Fecha] == FECHA_ULTIMOINVENTARIO
			    )
			)
			
			RETURN MEDIDA
		formatString: #,0
		displayFolder: Medidas Auxiliares
		lineageTag: 33209e38-b170-4b0d-b5e3-db6fb3b4b1bb

	measure 'AUX_Stock Inventario diario' =
			
			CALCULATE(
			    [Cantidad],
			    FILTER(
			        movimientos,
			        movimientos[TipoMovimiento] = "Control Stock diario"
			    )
			)
		formatString: #,0
		displayFolder: Medidas Inventarios
		lineageTag: 65a76b48-ab63-4c77-86b9-8743560cd86b

	measure 'Salidas Inventario' =
			
			CALCULATE(
			    [Cantidad],
			    movimientos[TipoMovimiento] = "Salida"
			)
		formatString: #,0
		lineageTag: 7e13ace2-0180-430f-9aa0-c9b4a33b0fa0

	measure 'Entradas Inventario' =
			
			CALCULATE(
			    [Cantidad],
			    movimientos[TipoMovimiento] = "Entrada"
			)
		formatString: #,0
		lineageTag: 2ec9e530-a664-48f0-8f7b-5224c256e618

	measure AUX_MinimaFechaActual = MIN(Fecha[Fecha])
		formatString: General Date
		displayFolder: Medidas Auxiliares
		lineageTag: 6053dd63-07d9-46e3-8b69-b2dce76f2cef

	measure 'Inventario Final' =
			
			VAR FILTRO_FECHA = [AUX_MaximaFechaActual]
			
			VAR MEDIDA =
			CALCULATE(
			    [AUX_Stock Inventario diario],
			    FILTER(
			        Fecha,
			        Fecha[Fecha] == FILTRO_FECHA
			    )
			)
			
			RETURN MEDIDA
		formatString: #,0
		displayFolder: Medidas Inventarios
		lineageTag: 0af17660-1694-4175-86a9-030b6ae7c436

	measure 'Inventario Inicial' =
			
			VAR FILTRO_FECHA = [AUX_MinimaFechaActual]
			
			VAR MEDIDA =
			CALCULATE(
			    [AUX_Stock Inventario diario],
			    FILTER(
			        Fecha,
			        Fecha[Fecha] == FILTRO_FECHA
			    )
			)
			
			RETURN MEDIDA
		formatString: #,0
		displayFolder: Medidas Inventarios
		lineageTag: 9b89b0db-6ba4-48ec-8bd0-2478f48881c2

	measure 'Inventario Promedio' =
			
			DIVIDE([AUX_Stock Inventario Cierre general], [AUX_Cantidad_dias_Cierre_general], BLANK())
		formatString: #,0
		displayFolder: Medidas Inventarios
		lineageTag: ebd82d38-7e1e-4afc-8746-004164d090fa

	measure 'Rotacion Inventario' = DIVIDE([Costo de Ventas], [Inventario Promedio], BLANK())
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: bd855452-93dc-45c6-98e2-29c545343f6d

	measure 'Peso Compras/Ventas' = DIVIDE([Compras], [Ventas], BLANK())
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 37b8ebe1-e7da-4e46-8f67-8d0740d7ec42

	measure 'Margen de Ventas' = [Ventas] - [Costo de Ventas]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 0d207cdc-c81d-4498-affe-7b95a2e0901c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure AUX_Cantidad_dias_inventario =
			
			CALCULATE(
			    DISTINCTCOUNT(movimientos[Fecha]),
			    FILTER(
			        movimientos,
			        OR(
			            movimientos[TipoMovimiento] = "Cierre de Stock general",
			            movimientos[TipoMovimiento] = "Control Stock diario"
			        )
			    )
			)
		formatString: 0
		displayFolder: Medidas Auxiliares
		lineageTag: 60558fcd-89af-4de2-9db2-3986cf91390a

	measure AUX_Cantidad_dias = DISTINCTCOUNT(Fecha[Fecha])
		formatString: 0
		displayFolder: Medidas Auxiliares
		lineageTag: def8911d-7023-4dc8-92b6-b35e270f53a9

	measure 'AUX_Monto Inventario de Cierre General' =
			
			CALCULATE(
			    [Monto],
			    FILTER(
			        movimientos,
			        movimientos[TipoMovimiento] = "Cierre de Stock general"
			    )
			)
		displayFolder: Medidas Inventarios
		lineageTag: db0db2d0-465a-4e7e-a53a-7aa71e524516

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AUX_Cantidad_dias_Cierre_general =
			
			CALCULATE(
			    DISTINCTCOUNT(movimientos[Fecha]),
			    FILTER(
			        movimientos,
			        movimientos[TipoMovimiento] = "Cierre de Stock general"
			    )
			)
		formatString: 0
		displayFolder: Medidas Auxiliares
		lineageTag: 9dde037c-fb75-43c2-9ba9-d912367e3e20

	measure 'AUX_Stock Inventario Cierre general' =
			
			CALCULATE(
			    [Cantidad],
			    FILTER(
			        movimientos,
			        movimientos[TipoMovimiento] = "Cierre de Stock general"
			    )
			)
		formatString: 0
		displayFolder: Medidas Inventarios
		lineageTag: 84f7c511-9479-49b9-bfb7-8da92a3f8d2c

	measure AUX_PrecioxCantidad = SUMX(movimientos, movimientos[PrecioUnitario]*movimientos[Cantidad])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: f8f9f94b-b6b4-4016-ba48-dc46211481ae

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure AUX_CostoxCantidad = SUMX(movimientos, movimientos[CostoUnitario]*movimientos[Cantidad])
		lineageTag: 2a9cb3a6-2d98-4b26-b769-4d4d66ed2196

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cantidad de Entradas' =
			
			CALCULATE(
			    [Cantidad],
			    FILTER(
			        movimientos,
			        movimientos[TipoMovimiento] = "Entrada"
			    )
			)
		formatString: 0
		lineageTag: 3478171c-708d-4b2b-86de-972503ba2717

	measure 'Cantidad de Salidas' =
			
			CALCULATE(
			    [Cantidad],
			    FILTER(
			        movimientos,
			        movimientos[TipoMovimiento] = "Salida"
			    )
			)
		formatString: 0
		lineageTag: ba2e6ec6-93aa-446b-bb77-5134c94c2a2c

	measure Entradas =
			
			CALCULATE(
			    [AUX_CostoxCantidad],
			    FILTER(
			        movimientos,
			        movimientos[TipoMovimiento] = "Entrada"
			    )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 7b86ebff-610c-4f32-b3e7-479f2c725d66

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure Salidas =
			
			-
			CALCULATE(
			    [AUX_PrecioxCantidad],
			    FILTER(
			        movimientos,
			        movimientos[TipoMovimiento] = "Salida"
			    )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 26325455-69c5-4e2f-a89a-6909a654ae73

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure 'Valor Inventario Final' =
			
			VAR FILTRO_FECHA = [AUX_MaximaFechaActual]
			
			VAR MEDIDA =
			CALCULATE(
			    [AUX_Monto Inventario diario],
			    FILTER(
			        Fecha,
			        Fecha[Fecha] == FILTRO_FECHA
			    )
			)
			
			RETURN MEDIDA
		lineageTag: 155aa1da-d904-4c17-9835-e0984188d030

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ganancias en Inventario' = [Salidas] - [Entradas]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 896f96f1-517c-4cf3-bd26-f9205092e10c

