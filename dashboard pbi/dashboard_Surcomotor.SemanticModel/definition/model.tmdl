model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-PY
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Fecha","Medidas","Medidas Predicciones","almacenes","movimientos","productos","vendedores"]

annotation PBI_ProTooling = ["DevMode"]

ref table Fecha
ref table Medidas
ref table 'Medidas Predicciones'
ref table almacenes
ref table movimientos
ref table productos
ref table vendedores

ref cultureInfo es-ES

